// Guppy de Linhagem — schema do banco de dados
// Single-store e-commerce: roles CUSTOMER e ADMIN apenas

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserRole {
  CUSTOMER // usuário normal do site
  EDITOR // pode editar produtos/categorias/hero, NÃO pedidos/settings
  ADMIN // tudo do EDITOR + pedidos + clientes
  SUPER_ADMIN // tudo + settings + gerenciar outros admins
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ProductType {
  FISICO
  DIGITAL
}

enum VideoPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
}

// ─────────────────────────────────────────────
// Usuários e Endereços
// ─────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  senhaHash         String?
  nome              String
  telefone          String?
  role              UserRole  @default(CUSTOMER)
  senhaPrecisaTroca Boolean   @default(false)
  ultimoLogin       DateTime?
  criadoEm          DateTime  @default(now())

  enderecos Address[]
  pedidos   Order[]
  waitlist  WaitlistEntry[]
}

model Address {
  id          String  @id @default(cuid())
  userId      String
  cep         String
  rua         String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  estado      String
  principal   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// Catálogo
// ─────────────────────────────────────────────

model Category {
  id    String @id @default(cuid())
  slug  String @unique
  nome  String
  ordem Int    @default(0)

  produtos Product[]
}

model Product {
  id              String      @id @default(cuid())
  slug            String      @unique
  nome            String
  descricao       String
  descricaoCurta  String?
  metaTitle       String?
  metaDescription String?
  keywords        String[]    @default([])

  // Atributos específicos do peixe (preenchidos manualmente no admin). São eixos
  // distintos — um peixe pode ser koi + halfmoon + dumbo ao mesmo tempo.
  sexoComposicao  String? // lista fixa: MACHO, FEMEA, CASAL, TRIO, LOTE
  padraoCor       String? // eixo principal de busca (koi, full red, tuxedo…) — livre
  cauda           String? // formato do rabo (halfmoon, delta, roundtail…) — livre
  caracteristica  String? // extra física (dumbo…) — livre, opcional
  origem          String? // nacional, americano, asiático… — livre

  // Atributos gerais de manejo (preenchidos pela IA, revisáveis).
  temperatura     String? // ex: "22–28°C"
  ph              String? // ex: "6.8–7.8"
  alimentacao     String? // ex: "Onívoro"
  expectativaVida String? // ex: "2–3 anos"
  porte           String? // ex: "~6 cm"
  preco           Decimal     @db.Decimal(10, 2)
  descontoPix     Decimal?    @db.Decimal(5, 2)
  parcelasMax     Int         @default(3)
  tipo            ProductType @default(FISICO)
  estoque         Int         @default(0)
  peso            Decimal?    @db.Decimal(8, 3)
  comprimento     Decimal?    @db.Decimal(8, 2)
  largura         Decimal?    @db.Decimal(8, 2)
  altura          Decimal?    @db.Decimal(8, 2)
  ativo           Boolean     @default(true)
  destaque        Boolean     @default(false)
  categoryId      String
  criadoEm        DateTime    @default(now())
  atualizadoEm    DateTime    @updatedAt

  category   Category        @relation(fields: [categoryId], references: [id])
  imagens    ProductImage[]
  videos     ProductVideo[]
  waitlist   WaitlistEntry[]
  orderItems OrderItem[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  ordem     Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVideo {
  id           String        @id @default(cuid())
  productId    String
  platform     VideoPlatform
  videoId      String? // ID extraído (YouTube); null p/ IG/TikTok
  originalUrl  String // URL original colada
  titulo       String? // do oEmbed (YouTube) ou manual (IG/TikTok)
  thumbnailUrl String? // auto (YouTube) ou URL manual (IG/TikTok)
  principal    Boolean       @default(false)
  ordem        Int           @default(0)
  criadoEm     DateTime      @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model WaitlistEntry {
  id         String   @id @default(cuid())
  productId  String
  userId     String?
  email      String
  notificado Boolean  @default(false)
  criadoEm   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@unique([productId, email])
}

// ─────────────────────────────────────────────
// Pedidos
// ─────────────────────────────────────────────

model Order {
  id              String      @id @default(cuid())
  numero          String      @unique
  userId          String
  subtotal        Decimal     @db.Decimal(10, 2)
  desconto        Decimal     @default(0) @db.Decimal(10, 2)
  frete           Decimal     @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  metodoPagamento String
  parcelas        Int         @default(1)
  status          OrderStatus @default(PENDING)
  mpPaymentId     String?
  mpPreferenceId  String?
  enderecoEntrega Json
  codigoRastreio  String?
  meCalcId        String?
  meShipmentId    String?
  criadoEm        DateTime    @default(now())
  atualizadoEm    DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  quantidade     Int
  precoUnitario  Decimal @db.Decimal(10, 2)
  nomeSnapshot   String
  imagemSnapshot String?

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

// ─────────────────────────────────────────────
// Hero / Home — slides editáveis e configurações globais
// ─────────────────────────────────────────────

model HeroSlide {
  id     String  @id @default(cuid())
  active Boolean @default(true)
  order  Int     @default(0)

  // Eyebrow (texto pequeno em cima do título)
  eyebrowText String?
  eyebrowIcon String? // nome do ícone Lucide (ex: "Trophy", "Award", "Star")

  // Título principal (duas linhas, segunda em destaque rosa)
  titleLine1 String
  titleLine2 String?

  // Subtítulo descritivo
  subtitle String? @db.Text

  // Imagem do peixe (PNG/WebP transparente)
  fishImageUrl String
  fishImageAlt String

  // Background opcional (se null, usa o default global)
  backgroundUrl String?

  // Selo de prêmio (canto/base)
  badgeText String?
  badgeYear String?
  badgeIcon String? // nome do ícone Lucide (ex: "Trophy")

  // CTAs (botões)
  primaryCtaText   String  @default("Comprar agora")
  primaryCtaUrl    String  @default("/loja")
  secondaryCtaText String?
  secondaryCtaUrl  String?

  // Vínculo opcional com produto (preparado pro futuro)
  productId String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([active, order])
}

model HeroSettings {
  id                   String  @id @default("default")
  autoplayEnabled      Boolean @default(true)
  autoplayDurationMs   Int     @default(5000)
  showArrows           Boolean @default(true)
  showDots             Boolean @default(true)
  defaultBackgroundUrl String  @default("/images/hero/bg-aquario-plantado.webp")

  atualizadoEm DateTime @updatedAt
}
