// Guppy de Linhagem — schema do banco de dados
// Single-store e-commerce: cliente (CUSTOMER) + equipe (EDITOR/ADMIN/SUPER_ADMIN)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserRole {
  CUSTOMER // usuário normal do site
  EDITOR // pode editar produtos/categorias/hero, NÃO pedidos/settings
  ADMIN // tudo do EDITOR + pedidos + clientes
  SUPER_ADMIN // tudo + settings + gerenciar outros admins
}

enum OrderStatus {
  RASCUNHO
  AGUARDANDO_PAGAMENTO
  PAGO
  ENVIADO
  ENTREGUE
  CANCELADO
}

enum FormaPagamento {
  PIX
  BOLETO
  CARTAO
  DINHEIRO
  OUTRO
}

enum Transportadora {
  JADLOG
  GOLLOG
  OUTRO
}

enum TipoEntrega {
  ENVIO // despacha pra casa do cliente (Jadlog/Gollog)
  RETIRADA // cliente retira presencialmente (frete 0, sem endereço)
}

// Order serve a dois fluxos. PEDIDO é a venda de peixes (carrinho, estoque,
// envio). COBRANCA é a cobrança avulsa: o admin monta um valor, manda o link
// pro cliente e ele paga no gateway. Mesma tabela porque webhook, estorno,
// caixa e histórico já falam "pedido" — o tipo só mantém a cobrança fora das
// listas de venda e das rotinas de despacho.
enum TipoOrder {
  PEDIDO
  COBRANCA
}

/// De onde a venda veio. Um pedido do marketplace tem ciclo próprio: quem cobra,
/// quem despacha e quem fala com o cliente é o marketplace, não a gente.
enum OrigemVenda {
  SITE
  WHATSAPP
  SHOPEE
}

enum ProviderPagamento {
  MERCADO_PAGO
  PICPAY
  PAGBANK
}

enum MetodoPagamento {
  PIX
  CARTAO
  BOLETO
  CARTEIRA
  GOOGLE_PAY
}

enum StatusPagamento {
  PENDENTE
  PAGO
  EM_ANALISE // cartão em análise (MP in_process) — não baixa estoque ainda
  RECUSADO
  ESTORNADO
  EXPIRADO
}

enum ProductType {
  PEIXE
  CORAL
  PLANTA
  ALIMENTO_VIVO
  RACAO
  ACESSORIO
  DIGITAL
}

enum TipoComposicao {
  TRIO
  CASAL
  MACHO
  FEMEA
  LOTE
}

enum VideoPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
}

enum TipoValorCupom {
  PERCENTUAL
  VALOR_FIXO
  PRECO_FIXO // "de R$ 250 por R$ 140": o valor É o preço final, não o desconto
}

enum EscopoCupom {
  TODOS
  CATEGORIAS
  PRODUTOS
}

enum ModoAplicacaoCupom {
  AMBOS_VENCE_MAIOR
  AMBOS_ACUMULA
  SO_PIX
  SO_CARTAO
}

enum TipoCupom {
  SECRETO // código digitado no carrinho (comportamento original)
  CAMPANHA // auto-aplica nos produtos do escopo e aparece na vitrine
}

// ─────────────────────────────────────────────
// Usuários e Endereços
// ─────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  senhaHash         String?
  nome              String
  telefone          String?
  role              UserRole  @default(CUSTOMER)
  senhaPrecisaTroca Boolean   @default(false)
  ultimoLogin       DateTime?
  criadoEm          DateTime  @default(now())

  // Limites operacionais do membro da equipe. O papel (role) diz em QUE áreas ele
  // mexe; estes campos limitam QUANTO ele pode mexer em dinheiro. SUPER_ADMIN
  // ignora todos — quem manda no time não se auto-limita. Ver lib/permissoes.ts.
  limiteDescontoPercent Int? // teto de desconto em % (null = sem teto)
  podeCancelarPedido    Boolean  @default(false)
  podeEstornar          Boolean  @default(false)
  limiteValorFinanceiro Decimal? @db.Decimal(10, 2) // teto R$ p/ cancelar pedido pago ou estornar

  /// Cargo do membro — de onde saem as permissões e as caixas que ele enxerga.
  /// Nulo em cliente (que não entra no painel) e em membro antigo ainda não
  /// migrado, que cai na lista fixa do papel por compatibilidade.
  cargoId String?
  cargo   Cargo?  @relation(fields: [cargoId], references: [id], onDelete: SetNull)

  // Campos que o Auth.js/PrismaAdapter espera (OAuth). `nome` (obrigatório) segue
  // sendo a fonte de verdade do app; o adapter preenche `name` e, no createUser
  // customizado (lib/auth.ts), copiamos name→nome. `emailVerified`/`image` vêm do
  // provider. Login por credenciais (admin) não usa nada disto.
  name          String?
  image         String?
  emailVerified DateTime?

  enderecos    Address[]
  pedidos      Order[]
  waitlist     WaitlistEntry[]
  cliente      Cliente?
  notificacoes Notificacao[]
  accounts     Account[]
  tokensSenha  TokenSenha[]
  lancamentos  Lancamento[]
  auditorias   AuditoriaAdmin[]
  visitas      Visitante[]
}

/// Cargo: o conjunto de permissões que o dono monta no painel.
///
/// Antes as permissões eram três listas fixas no código, o que obrigava um
/// deploy para cada arranjo novo ("admin da estufa", "admin de produtos"). Agora
/// o dono cria o cargo, marca o que ele pode e a que caixa ele tem acesso, e
/// depois só escolhe o cargo ao cadastrar a pessoa.
///
/// `protegido` marca o cargo de dono: ele tem tudo por definição e não pode ser
/// apagado nem ter permissão removida. É a trava contra o painel ficar sem
/// ninguém capaz de gerenciar equipe — um clique errado não tranca todo mundo
/// para fora.
model Cargo {
  id                   String               @id @default(cuid())
  nome                 String               @unique
  descricao            String?
  /// Lista de Permissao (lib/permissoes.ts). Texto e não enum: a lista de
  /// permissões muda a cada funcionalidade nova do painel, e migrar enum a cada
  /// deploy sairia caro sem ganho — o código valida contra PERMISSOES_TODAS.
  permissoes           String[]             @default([])
  /// Caixas que este cargo enxerga. Vazio = todos.
  segmentosFinanceiros SegmentoFinanceiro[] @default([])
  protegido            Boolean              @default(false)
  ordem                Int                  @default(0)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuarios User[]

  @@index([ordem])
}

// Vínculo de conta OAuth (Google/Facebook) ao User — model padrão do Auth.js.
// Sessão continua JWT (sem Session/VerificationToken); o adapter usa Account só
// para persistir o vínculo do provider.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Address {
  id          String  @id @default(cuid())
  userId      String
  cep         String
  rua         String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  estado      String
  principal   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Cliente: tabela própria, desacoplada do auth. Nome e telefone (WhatsApp) são
// os únicos obrigatórios — um lead entra só com esses dois. userId opcional é
// groundwork para plugar a conta do cliente no futuro.
model Cliente {
  id          String  @id @default(cuid())
  nome        String
  telefone    String? // WhatsApp — opcional (guardado só com dígitos)
  email       String?
  cpfCnpj     String? // entra na minuta Gollog (guardado só com dígitos)
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String? @db.VarChar(2)
  observacoes String?

  /// Descadastro de campanhas. Aviso de pedido continua saindo — é resposta a
  /// uma compra que a pessoa fez, não divulgação.
  aceitaEmails Boolean @default(true)

  /// Quando o próprio cliente preencheu os dados pelo link público (/cadastro),
  /// depois de fechar a venda no WhatsApp. Nulo = cadastro digitado por nós.
  /// A tela de venda pelo WhatsApp lista os mais recentes para puxar num clique.
  cadastroProprioEm DateTime?

  userId String? @unique // futuro: conta do cliente
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  pedidos      Order[]
  notificacoes Notificacao[]
  visitas      Visitante[]
  criadoEm     DateTime      @default(now())

  @@index([nome])
  @@index([cadastroProprioEm])
}

// ─────────────────────────────────────────────
// Catálogo
// ─────────────────────────────────────────────

model Category {
  id    String @id @default(cuid())
  slug  String @unique
  nome  String
  ordem Int    @default(0)

  produtos Product[]
  cupons   CupomDesconto[] @relation("CupomCategorias")
}

model Product {
  id              String   @id @default(cuid())
  slug            String   @unique
  nome            String
  descricao       String
  descricaoCurta  String?
  metaTitle       String?
  metaDescription String?
  keywords        String[] @default([])

  // Atributos específicos do peixe (preenchidos manualmente no admin). São eixos
  // distintos — um peixe pode ser koi + halfmoon + dumbo ao mesmo tempo.
  // (composição saiu para ProductVariant.)
  padraoCor      String? // eixo principal de busca (koi, full red, tuxedo…) — livre
  cauda          String? // formato do rabo (halfmoon, delta, roundtail…) — livre
  caracteristica String? // extra física (dumbo…) — livre, opcional
  origem         String? // nacional, americano, asiático… — livre

  // Atributos gerais de manejo (preenchidos pela IA, revisáveis).
  temperatura           String? // ex: "22–28°C"
  ph                    String? // ex: "6.8–7.8"
  alimentacao           String? // ex: "Onívoro"
  expectativaVida       String? // ex: "2–3 anos"
  preco                 Decimal     @db.Decimal(10, 2)
  descontoPix           Decimal?    @db.Decimal(5, 2) // % de desconto Pix PRÓPRIO do produto (0–100)
  usarDescontoPixGlobal Boolean     @default(false) // sem desconto próprio → usa o global da loja
  parcelasMax           Int         @default(3)
  tipo                  ProductType @default(PEIXE)
  estoque               Int         @default(0) // PEIXE: espelho de machos+femeas; não-PEIXE: real
  estoqueMachos         Int         @default(0) // só PEIXE (pool real)
  estoqueFemeas         Int         @default(0) // só PEIXE (pool real)
  peso                  Decimal?    @db.Decimal(8, 3)
  comprimento           Decimal?    @db.Decimal(8, 2)
  largura               Decimal?    @db.Decimal(8, 2)
  altura                Decimal?    @db.Decimal(8, 2)
  ativo                 Boolean     @default(true)
  destaque              Boolean     @default(false)
  // Linha campeã mundial (World Guppy Contest). Liga o selo de tricampeão no
  // card/página do produto. Marcação manual no admin — nunca por nome.
  linhagemCampea        Boolean     @default(false)
  categoryId            String
  criadoEm              DateTime    @default(now())
  atualizadoEm          DateTime    @updatedAt

  category   Category         @relation(fields: [categoryId], references: [id])
  imagens    ProductImage[]
  videos     ProductVideo[]
  waitlist   WaitlistEntry[]
  orderItems OrderItem[]
  variantes  ProductVariant[]
  cupons     CupomDesconto[]  @relation("CupomProdutos")
  shopee     ShopeeAnuncio[]
}

// Composição de venda (trio/casal/macho/fêmea/lote). Só produtos PEIXE têm
// variantes — preço/estoque por composição. Não-peixe usa Product.preco/estoque.
model ProductVariant {
  id         String         @id @default(cuid())
  productId  String
  composicao TipoComposicao
  preco      Decimal        @db.Decimal(10, 2)
  qtdMachos  Int            @default(0) // receita: machos consumidos do pool
  qtdFemeas  Int            @default(0) // receita: fêmeas consumidas do pool
  rotulo     String? // só LOTE: "8 machos e 2 fêmeas" (exibição)
  padrao     Boolean        @default(false) // TRIO = true (pré-selecionado na compra)
  ativo      Boolean        @default(true)
  ordem      Int            @default(0)
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, composicao])
  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  ordem     Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVideo {
  id           String        @id @default(cuid())
  productId    String
  platform     VideoPlatform
  videoId      String? // ID extraído (YouTube); null p/ IG/TikTok
  originalUrl  String // URL original colada
  titulo       String? // do oEmbed (YouTube) ou manual (IG/TikTok)
  thumbnailUrl String? // auto (YouTube) ou URL manual (IG/TikTok)
  principal    Boolean       @default(false)
  ativo        Boolean       @default(true) // oculta o vídeo na loja sem apagar
  ordem        Int           @default(0)
  criadoEm     DateTime      @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model WaitlistEntry {
  id         String   @id @default(cuid())
  productId  String
  userId     String?
  email      String? // legado/conta logada; a captura pública usa whatsapp
  whatsapp   String? // lista de espera pública (digits BR)
  notificado Boolean  @default(false)
  criadoEm   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@unique([productId, email])
  @@unique([productId, whatsapp]) // dedup por whatsapp no mesmo produto
}

// ─────────────────────────────────────────────
// Pedidos
// ─────────────────────────────────────────────

model Order {
  id        String @id @default(cuid())
  numero    String @unique // "#2026-0001"
  ano       Int
  sequencia Int

  // Vínculo: cliente obrigatório (pedido manual); user opcional (checkout futuro).
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])

  tipo            TipoOrder       @default(PEDIDO) // COBRANCA = cobrança avulsa por link
  /// De onde veio a venda. SITE é o checkout; WHATSAPP é a venda lançada no
  /// painel; SHOPEE (e o que vier depois) é pedido importado do marketplace.
  /// Governa o que o painel oferece: pedido de marketplace não cobra pagamento
  /// nosso nem compra etiqueta no Melhor Envio, porque quem faz isso é a Shopee.
  origem          OrigemVenda     @default(SITE)
  /// Número do pedido no marketplace (order_sn na Shopee). Único por origem —
  /// é a trava que impede o mesmo pedido de entrar duas vezes quando o webhook
  /// repete ou quando a varredura roda junto.
  origemPedidoId  String?
  status          OrderStatus     @default(RASCUNHO)
  estoqueBaixado  Boolean         @default(false) // baixa de pool já aplicada (evita dupla)
  formaPagamento  FormaPagamento?
  transportadora  Transportadora?
  observacoes     String?
  enderecoEntrega Json // SNAPSHOT do destinatário (ver lib/validations/pedido.ts)

  subtotal Decimal @default(0) @db.Decimal(10, 2)
  frete    Decimal @default(0) @db.Decimal(10, 2)
  desconto Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @default(0) @db.Decimal(10, 2)

  /// Embalagem REAL deste pedido, quando o operador informa.
  ///
  /// O cálculo automático empilha as medidas dos produtos, o que é um chute
  /// conservador: ele não sabe que a criadeira desmonta e cabe num envelope,
  /// nem que dois itens finos vão lado a lado. Nulo = usa o automático.
  pacoteAltura      Decimal? @db.Decimal(8, 2) // cm
  pacoteLargura     Decimal? @db.Decimal(8, 2)
  pacoteComprimento Decimal? @db.Decimal(8, 2)
  pacotePesoGramas  Int?

  modalidadeFrete  String? // 'TERRESTRE' (Jadlog) | 'AEREO' (Gollog) | 'SECO' (produto não vivo)
  // Serviço do Melhor Envio escolhido no checkout de produto seco. O enum
  // Transportadora tem 3 valores e não acompanha o catálogo do ME (que muda
  // sozinho), então o id/nome reais ficam aqui e o enum vira OUTRO.
  servicoEnvioId   Int?
  servicoEnvioNome String?
  tipoEntrega      TipoEntrega @default(ENVIO) // ENVIO (despacha) | RETIRADA (cliente busca)
  codigoRastreio   String? // AWB (Gollog) ou código da transportadora (Jadlog)
  selfTracking     String? // código ME…BR (Melhor Rastreio) — o link do cliente
  etiquetaUrl      String? // PDF da etiqueta gerada no Melhor Envio (print público)
  rastreioStatus   String? // último status conhecido no ME (posted/delivered/…)
  enviadoEm        DateTime? // quando virou ENVIADO (etiqueta gerada ou registro manual)

  // Cupom aplicado (opcional). cupomCodigo é snapshot (sobrevive à exclusão do cupom).
  cupomId     String?
  cupom       CupomDesconto? @relation(fields: [cupomId], references: [id], onDelete: SetNull)
  cupomCodigo String?

  // Cobrança avulsa (tipo = COBRANCA). publicToken é o segredo do link que vai
  // pro cliente (numero é sequencial, logo adivinhável — nunca serve de link).
  // expiraEm fecha o link; maxParcelas limita o parcelamento no gateway.
  /// Semana em que o cliente PEDIU para receber (segunda-feira, meio-dia UTC).
  /// É um desejo, não um compromisso: a loja tenta encaixar. Nulo = "assim que
  /// estiver pronto". Também é preenchido na venda avulsa, para o resumo do
  /// Telegram lembrar a loja na semana certa.
  semanaEnvio DateTime?

  publicToken String?   @unique
  expiraEm    DateTime?
  maxParcelas Int?

  // Scaffold de checkout/integrações — dormente (reconciliado nas fases
  // Pagamentos/Envio; não usar/não apagar). parcelas: parcelamento de cartão.
  parcelas       Int?
  mpPaymentId    String?
  mpPreferenceId String?
  meCalcId       String?
  meShipmentId   String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  items           OrderItem[]
  pagamentos      Pagamento[]
  rastreioEventos RastreioEvento[]
  notificacoes    Notificacao[]
  lancamentos     Lancamento[]

  @@unique([ano, sequencia])
  @@unique([origem, origemPedidoId])
  @@index([clienteId])
  @@index([status])
  @@index([tipo])
  @@index([semanaEnvio])
  @@index([origem, status])
}

// Histórico de rastreio de um pedido (uma linha por ocorrência do Melhor Envio).
// O poll é idempotente: a unique (orderId, status, ocorridoEm) impede duplicar a
// mesma ocorrência a cada varredura. Uma ocorrência nova = notificar o cliente.
model RastreioEvento {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status     String // status/ocorrência do ME (ex.: posted, in_transit, delivered)
  descricao  String? // texto da ocorrência, quando o ME fornece
  ocorridoEm DateTime // data da ocorrência (fonte: Melhor Envio)
  criadoEm   DateTime @default(now())

  @@unique([orderId, status, ocorridoEm])
  @@index([orderId])
}

// Notificação ao cliente — CANAL-AGNÓSTICA. Hoje alimenta o feed do painel; e-mail
// e WhatsApp (futuro) lêem daqui. Vinculada ao pedido e ao destinatário (cliente
// guest e/ou user logado). `tipo`: "ENVIADO" | "STATUS" | "ENTREGUE".
model Notificacao {
  id        String   @id @default(cuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo      String
  titulo    String
  corpo     String
  lida      Boolean  @default(false)
  criadoEm  DateTime @default(now())

  @@index([clienteId])
  @@index([userId])
  @@index([orderId])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  productId      String? // null = item avulso
  quantidade     Int
  precoUnitario  Decimal         @db.Decimal(10, 2) // SNAPSHOT
  nomeProduto    String // SNAPSHOT
  imagemSnapshot String? // SNAPSHOT (opcional)
  composicao     TipoComposicao? // snapshot da composição (null em avulso/não-peixe)
  qtdMachos      Int? // snapshot da receita (null em avulso/não-peixe)
  qtdFemeas      Int?

  // Desconto por item (campanha automática OU código secreto, o que vencer).
  descontoUnitario Decimal? @db.Decimal(10, 2) // abatimento em R$ por unidade
  cupomId          String?
  cupomCodigo      String? // snapshot do código do cupom vencedor

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  cupom   CupomDesconto? @relation("ItemCupom", fields: [cupomId], references: [id], onDelete: SetNull)
}

model Pagamento {
  id            String            @id @default(cuid())
  orderId       String
  order         Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      ProviderPagamento
  metodo        MetodoPagamento
  status        StatusPagamento   @default(PENDENTE)
  valor         Decimal           @db.Decimal(10, 2)
  externalId    String? // id da cobrança no gateway
  linkPagamento String?
  qrCode        String?
  parcelas      Int? // cartão: nº de parcelas da tentativa (1–12)
  bandeira      String? // cartão: "visa"/"master"/… (só exibição)
  payloadRaw    Json?
  // Estorno (refund). estornadoEm é a TRAVA de idempotência (action + webhook);
  // refundId é o id do refund no gateway (snapshot). Nulos = não estornado.
  estornadoEm   DateTime?
  refundId      String?
  criadoEm      DateTime          @default(now())

  @@index([orderId])
}

/// Etapa em que a tentativa de cartão morreu.
enum EtapaCartao {
  SDK // o SDK/Brick do gateway não carregou no navegador do cliente
  FORMULARIO // o Brick recusou os dados antes de gerar o token (não virou pagamento)
  COBRANCA // falhamos ao criar o pagamento no gateway (rede, 4xx, timeout)
  RECUSA // o gateway criou o pagamento e recusou
}

/// Tentativa de cartão que NÃO virou uma linha de Pagamento.
///
/// Existe porque a recusa que o cliente vê nem sempre chega até aqui: quando o
/// SDK não carrega ou o Brick nega os dados, não há pedido, não há Pagamento e
/// não há log — o cliente avisa que "deu recusado" e não sobra nada para
/// investigar. Cada tentativa frustrada agora deixa rastro, com o motivo
/// técnico, para o dono saber se é cartão do cliente ou defeito nosso.
///
/// NUNCA guarda dado de cartão (número, CVV, token): só o motivo e o contexto.
model TentativaCartao {
  id           String            @id @default(cuid())
  etapa        EtapaCartao
  provider     ProviderPagamento?
  mensagem     String // motivo técnico (gateway ou navegador)
  statusDetail String? // status_detail do gateway, quando houver
  valor        Decimal?          @db.Decimal(10, 2)
  parcelas     Int?
  deviceOk     Boolean           @default(false) // fingerprint do antifraude chegou?
  orderId      String? // pedido, quando já existia
  numero       String? // snapshot do número do pedido
  email        String? // p/ chamar o cliente de volta
  telefone     String?
  userAgent    String?
  criadoEm     DateTime          @default(now())

  @@index([criadoEm])
  @@index([etapa, criadoEm])
}

// ─────────────────────────────────────────────
// Hero / Home — slides editáveis e configurações globais
// ─────────────────────────────────────────────

model HeroSlide {
  id     String  @id @default(cuid())
  active Boolean @default(true)
  order  Int     @default(0)

  // Eyebrow (texto pequeno em cima do título)
  eyebrowText String?
  eyebrowIcon String? // nome do ícone Lucide (ex: "Trophy", "Award", "Star")

  // Título principal (duas linhas, segunda em destaque rosa)
  titleLine1 String
  titleLine2 String?

  // Subtítulo descritivo
  subtitle String? @db.Text

  // Imagem do peixe (PNG/WebP transparente)
  fishImageUrl String
  fishImageAlt String

  // Background opcional (se null, usa o default global)
  backgroundUrl String?

  // Selo de prêmio (canto/base)
  badgeText String?
  badgeYear String?
  badgeIcon String? // nome do ícone Lucide (ex: "Trophy")

  // CTAs (botões)
  primaryCtaText   String  @default("Comprar agora")
  primaryCtaUrl    String  @default("/loja")
  secondaryCtaText String?
  secondaryCtaUrl  String?

  // Vínculo opcional com produto (preparado pro futuro)
  productId String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([active, order])
}

model HeroSettings {
  id                   String  @id @default("default")
  autoplayEnabled      Boolean @default(true)
  autoplayDurationMs   Int     @default(5000)
  showArrows           Boolean @default(true)
  showDots             Boolean @default(true)
  defaultBackgroundUrl String  @default("/images/hero/bg-aquario-plantado.webp")

  atualizadoEm DateTime @updatedAt
}

// Configurações globais da loja (singleton: 1 linha, id "default"). Enxuto —
// começa só com o desconto Pix global; vamos reaproveitar para outras configs.
/// Pedido de "esqueci minha senha".
///
/// Guarda o HASH do token, nunca ele: com o hash, um vazamento do banco não
/// permite redefinir a senha de ninguém. Uso único (usadoEm) e vida curta
/// (expiraEm) — link antigo no histórico do e-mail não vale mais nada.
model TokenSenha {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  @@index([userId])
  @@index([expiraEm])
}

/// Quem recebe uma campanha.
enum PublicoCampanha {
  TODOS // todo cliente com e-mail
  COMPRADORES // já teve pedido pago
  SEM_COMPRA // cadastrado, nunca comprou
  LEADS // deixou contato no checkout e não converteu
}

enum StatusCampanha {
  RASCUNHO
  AGENDADA
  ENVIANDO
  ENVIADA
  CANCELADA
}

/// Campanha de e-mail: promoção ou aviso disparado para uma lista.
///
/// Diferente de TemplateEmail (que é o texto de um aviso automático do sistema),
/// esta é uma mensagem pontual, com público, agendamento e histórico de envio.
model CampanhaEmail {
  id      String          @id @default(cuid())
  nome    String // uso interno, na lista do painel
  assunto String
  titulo  String
  corpo   String
  publico PublicoCampanha @default(TODOS)
  status  StatusCampanha  @default(RASCUNHO)

  /// Quando disparar. Nulo = envio manual.
  agendadaPara DateTime?
  iniciadaEm   DateTime?
  concluidaEm  DateTime?

  criadaEm     DateTime @default(now())
  atualizadaEm DateTime @updatedAt

  envios EnvioCampanha[]

  @@index([status, agendadaPara])
}

/// Um destinatário de uma campanha.
///
/// A lista é congelada no disparo: quem entrar na base depois não recebe uma
/// campanha que já saiu, e reenviar não duplica para quem já recebeu.
model EnvioCampanha {
  id         String        @id @default(cuid())
  campanhaId String
  campanha   CampanhaEmail @relation(fields: [campanhaId], references: [id], onDelete: Cascade)

  email String
  nome  String

  enviadoEm  DateTime?
  erro       String?
  tentativas Int       @default(0)

  criadoEm DateTime @default(now())

  @@unique([campanhaId, email])
  @@index([campanhaId, enviadoEm])
}

/// Texto de um e-mail automático, editável no painel.
///
/// A chave é string (não enum) de propósito: acrescentar uma mensagem nova não
/// deve exigir migration. O que o código garante é o CATÁLOGO em
/// lib/emails/catalogo.ts — chave desconhecida no banco é simplesmente ignorada,
/// e chave do catálogo sem linha no banco usa o texto padrão.
model TemplateEmail {
  chave   String  @id
  assunto String
  titulo  String
  corpo   String
  ativo   Boolean @default(true) // desligado = esse aviso não é enviado

  // Texto de fábrica, gravado junto na criação e nunca alterado pelo painel. É a
  // referência do botão "voltar ao texto padrão" — sem isso, estragar o texto
  // não teria volta, já que o código não guarda mais cópia nenhuma.
  assuntoPadrao String
  tituloPadrao  String
  corpoPadrao   String

  atualizadoEm DateTime @updatedAt
}

/// Como o servidor de e-mail espera a conexão. STARTTLS é a porta 587 (conexão
/// limpa que vira TLS); SSL é a 465 (TLS desde o primeiro byte).
enum SegurancaSmtp {
  STARTTLS
  SSL
  NENHUMA
}

/// Conta de e-mail que o site usa para enviar (singleton, cadastrada no admin).
///
/// A senha fica CRIPTOGRAFADA (AES-256-GCM, chave derivada do AUTH_SECRET) e não
/// volta para a tela em momento nenhum — o SMTP precisa dela em texto na hora do
/// envio, então hash não serve, mas um dump do banco sozinho não a revela.
model ConfiguracaoEmail {
  id                 String        @id @default("default")
  ativo              Boolean       @default(false) // desligado = site não tenta enviar nada
  host               String
  porta              Int           @default(587)
  seguranca          SegurancaSmtp @default(STARTTLS)
  usuario            String
  senhaCriptografada String

  remetenteNome  String // o que aparece como nome do remetente
  remetenteEmail String // precisa ser um endereço que o servidor autorize
  responderPara  String? // Reply-To, quando as respostas vão para outro endereço

  // Resultado do último teste — o admin vê se a conta está mesmo funcionando.
  ultimoTesteEm   DateTime?
  ultimoTesteOk   Boolean?
  ultimoTesteErro String?

  atualizadoEm DateTime @updatedAt
}

model ConfiguracaoLoja {
  id                       String   @id @default("default")
  descontoPixGlobalPercent Int      @default(0) // 0–100, aplicado a produtos com usarDescontoPixGlobal
  freteGratisAtivo         Boolean  @default(false) // liga/desliga o frete grátis por valor
  freteGratisAcimaDe       Decimal? @db.Decimal(10, 2) // subtotal mínimo (preço cheio/cartão) p/ frete grátis
  maxPeixesFreteAuto       Int      @default(10) // até este nº cota frete automático; acima → WhatsApp
  retiradaLocalAtiva       Boolean  @default(false) // oferece "retirar pessoalmente" no checkout (frete 0)
  retiradaInstrucoes       String? // texto livre exibido ao cliente que escolhe retirada
  tarjaAtiva               Boolean  @default(false) // liga/desliga a tarja promocional no topo
  tarjaTexto               String? // texto livre da tarja; vazio → usa o fallback do componente
  pagbankAtivo             Boolean  @default(false) // oferece PagBank (cartão/Pix/boleto) no checkout
  // Produto seco (não é carga viva): o cliente paga a cotação do Melhor Envio
  // mais esta taxa fixa de embalagem. O isopor de R$ 20 é só do peixe.
  taxaEmbalagemSeco        Decimal  @default(5) @db.Decimal(10, 2)

  /// Remetente da etiqueta. O Melhor Envio recusa a compra sem rua, número,
  /// bairro, documento e telefone de quem envia — dado que o sistema não tinha
  /// em lugar nenhum (só havia CEP/cidade/UF, e um "logradouro" que era o nome
  /// da fazenda). Fica aqui, editável, em vez de constante no código.
  remetenteNome        String?
  remetenteDocumento   String? // CPF ou CNPJ, só dígitos
  remetenteEmail       String?
  remetenteTelefone    String? // só dígitos
  remetenteCep         String?
  remetenteLogradouro  String?
  remetenteNumero      String?
  remetenteComplemento String?
  remetenteBairro      String?
  remetenteCidade      String?
  remetenteUf          String?  @db.VarChar(2)
  atualizadoEm         DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Cupons de desconto (código digitado no carrinho — não aparece na vitrine)
// ─────────────────────────────────────────────

model CupomDesconto {
  id                      String             @id @default(cuid())
  codigo                  String             @unique // normalizado UPPERCASE
  descricao               String? // uso interno (admin)
  tipoValor               TipoValorCupom
  valor                   Decimal            @db.Decimal(10, 2) // % ou R$
  escopo                  EscopoCupom        @default(TODOS)
  modoAplicacao           ModoAplicacaoCupom @default(AMBOS_VENCE_MAIOR)
  tipoCupom               TipoCupom          @default(SECRETO) // SECRETO (digitado) | CAMPANHA (vitrine)
  precoUnicoNaCampanha    Boolean            @default(true) // só CAMPANHA: true = Pix igual ao cartão
  ativo                   Boolean            @default(true)
  validoDe                DateTime?
  validoAte               DateTime?
  limiteUsos              Int? // null = ilimitado
  usosRealizados          Int                @default(0)
  encerraAoEsgotarEstoque Boolean            @default(false)
  pedidoMinimo            Decimal?           @db.Decimal(10, 2)
  criadoEm                DateTime           @default(now())
  atualizadoEm            DateTime           @updatedAt

  categorias Category[]  @relation("CupomCategorias")
  produtos   Product[]   @relation("CupomProdutos")
  pedidos    Order[]
  itens      OrderItem[] @relation("ItemCupom")

  @@index([ativo])
  @@index([tipoCupom, ativo])
}

// Lead do checkout: contato capturado ANTES do pagamento (recuperação de carrinho
// abandonado). O cron avisa no Telegram se o lead não virar pedido em ~15 min.
// `convertido` = criou pedido; `notificadoEm` = já avisamos o abandono (não repete).
model LeadCheckout {
  id           String    @id @default(cuid())
  nome         String?
  telefone     String? // só dígitos
  email        String?
  capturadoEm  DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  notificadoEm DateTime?
  convertido   Boolean   @default(false)

  @@index([convertido, notificadoEm])
  @@index([email])
  @@index([telefone])
}

// ─────────────────────────────────────────────
// Financeiro — caixa de entradas e saídas
//
// Regime de CAIXA: o mês fecha pelo dinheiro que entrou e saiu de fato, então só
// lançamento CONFIRMADO entra na conta. PENDENTE cobre duas coisas que ainda não
// mexeram no caixa: a venda do site esperando conferência e a conta a pagar que
// ainda não venceu. `valor` é sempre positivo — quem dá o sinal é o `tipo`.
// ─────────────────────────────────────────────

enum TipoLancamento {
  ENTRADA
  SAIDA
}

enum StatusLancamento {
  PENDENTE // esperando confirmação (venda do site) ou vencimento (conta a pagar)
  CONFIRMADO // dinheiro entrou/saiu — é o que forma o caixa
  DESCARTADO // sugestão recusada; fica no histórico, fora das contas
}

/// De onde veio o cliente dessa venda. Só faz sentido em ENTRADA e é sempre
/// opcional — serve para saber que canal traz dinheiro, não para travar o
/// lançamento.
enum CanalVenda {
  GOOGLE
  SITE
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  TIKTOK
  WHATSAPP
  MERCADO_LIVRE
  OLX
  INDICACAO
  EVENTO
  OUTRO
}

enum OrigemLancamento {
  MANUAL
  PEDIDO // venda do site
  TAXA_PAGAMENTO // taxa do gateway sobre uma venda
  FRETE // custo de postagem de uma venda
  RECORRENCIA
  COMPROVANTE // criado a partir de PDF/imagem/texto lido
}

/// Unidade de negócio de um lançamento, e quem é dono dela.
///
/// PEIXES_VIVOS é a estufa, uma SOCIEDADE: as vendas de peixe e todo o custo de
/// manter a estufa em pé (ração, remédio, matriz, luz, água, internet, aluguel,
/// imposto da estufa) entram aqui, porque é este resultado que os sócios
/// dividem. PRODUTOS é a loja de aquarismo, projeto de um sócio só.
///
/// Não existe gaveta de "custo compartilhado" de propósito: ela deixaria o
/// resultado da sociedade incompleto, e é justamente esse número que precisa
/// fechar sozinho. Despesa que serve os dois (um imposto, um anúncio) é lançada
/// em duas linhas, cada uma no seu lado.
///
/// É também o eixo de PRIVACIDADE do financeiro: User.segmentosFinanceiros diz
/// quais destes o membro enxerga.
enum SegmentoFinanceiro {
  PEIXES_VIVOS
  PRODUTOS
}

// Categorias são editáveis, mas as marcadas com `sistema` são procuradas por slug
// pelo código (venda do site, taxa, frete) — dá para renomear, não para apagar.
model CategoriaFinanceira {
  id             String              @id @default(cuid())
  nome           String
  slug           String              @unique
  tipo           TipoLancamento? // null = serve para entrada e saída
  sistema        Boolean             @default(false)
  /// Segmento sugerido ao escolher esta categoria no formulário. Só sugestão:
  /// quem lança pode mudar (uma mesma categoria pode servir os dois negócios).
  segmentoPadrao SegmentoFinanceiro?
  ordem          Int                 @default(0)
  ativa          Boolean             @default(true)
  criadoEm       DateTime            @default(now())

  lancamentos  Lancamento[]
  recorrencias RecorrenciaFinanceira[]

  @@index([tipo, ativa])
}

model Lancamento {
  id         String             @id @default(cuid())
  /// A que negócio este dinheiro pertence. Default PEIXES_VIVOS porque a estufa
  /// é a operação antiga: se algum caminho novo esquecer de definir, o valor cai
  /// no lugar onde ele historicamente estaria, não numa gaveta neutra errada.
  segmento   SegmentoFinanceiro @default(PEIXES_VIVOS)
  tipo       TipoLancamento
  status     StatusLancamento   @default(CONFIRMADO)
  origem     OrigemLancamento   @default(MANUAL)
  descricao  String
  valor      Decimal            @db.Decimal(10, 2) // sempre positivo
  data       DateTime // quando mexeu no caixa (ou previsão, se pendente)
  vencimento DateTime? // contas a pagar/receber

  categoriaId String?
  categoria   CategoriaFinanceira? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  // Vínculo com a venda que originou o lançamento (entrada, taxa ou frete).
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Trava de idempotência: o mesmo pagamento não gera duas vezes a mesma linha,
  // mesmo com o webhook do gateway reenviando.
  pagamentoId String?

  comprovanteUrl String? // PDF/imagem no S3
  observacoes    String?

  // Marcação de venda (opcional, só em ENTRADA): por onde o cliente chegou e em
  // que campanha a venda entrou. Campanha é texto livre porque cada uma tem nome
  // próprio; o formulário sugere as já usadas para não virar grafia solta.
  canal    CanalVenda?
  campanha String?

  recorrenciaId String?
  recorrencia   RecorrenciaFinanceira? @relation(fields: [recorrenciaId], references: [id], onDelete: SetNull)

  criadoPorId String?
  criadoPor   User?   @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([pagamentoId, origem])
  @@index([segmento, status, data])
  @@index([status, data])
  @@index([data])
  @@index([categoriaId])
  @@index([orderId])
  @@index([canal])
  @@index([campanha])
  @@index([status, vencimento])
}

// Despesa que se repete todo mês (energia, internet, ração). O cron gera a conta
// do mês uma única vez — `ultimaCompetencia` ("2026-08") é a trava.
model RecorrenciaFinanceira {
  id            String             @id @default(cuid())
  /// Conta que se repete costuma ser estrutura da estufa (energia, internet,
  /// aluguel), que é custo da sociedade.
  segmento      SegmentoFinanceiro @default(PEIXES_VIVOS)
  tipo          TipoLancamento     @default(SAIDA)
  descricao     String
  valor         Decimal            @db.Decimal(10, 2)
  diaVencimento Int // 1–28, para existir em todo mês
  ativa         Boolean            @default(true)
  observacoes   String?

  categoriaId String?
  categoria   CategoriaFinanceira? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  ultimaCompetencia String? // "AAAA-MM" já gerado
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  lancamentos Lancamento[]

  @@index([ativa])
}

// ─────────────────────────────────────────────
// Auditoria e rastreio
//
// Duas coisas diferentes no mesmo lugar do schema:
//  1. AuditoriaAdmin — o que a EQUIPE fez no painel. Registro interno da loja,
//     com o valor antes e depois de cada mudança.
//  2. Visitante/SessaoVisita/EventoVisitante — o que o CLIENTE fez no site.
//
// Sobre dado pessoal: o IP só é guardado inteiro quando a pessoa aceitou os
// cookies; sem consentimento, o último octeto vira "xxx" e a geolocalização
// nem é consultada (ver lib/rastreio/ip.ts). Nada aqui é apagado sozinho — a
// limpeza é manual, e o painel avisa quando há registro com mais de 90 dias.
// ─────────────────────────────────────────────

model AuditoriaAdmin {
  id String @id @default(cuid())

  // Quem fez. O nome é SNAPSHOT: se a pessoa sair da equipe e a conta for
  // removida, o histórico continua dizendo quem foi.
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userNome  String
  userEmail String
  userPapel String

  acao       String // "produto.atualizar", "pedido.cancelar"…
  entidade   String? // "Product", "Order"…
  entidadeId String?
  /**
   * Frase pronta para leitura humana ("mudou o preço de X de R$ 80 para R$ 90").
   */
  descricao  String

  /**
   * Só os campos que mudaram, para o histórico não virar um dump do banco.
   */
  antes  Json?
  depois Json?

  ip        String?
  userAgent String?

  ocorridoEm DateTime @default(now())

  @@index([ocorridoEm])
  @@index([userId, ocorridoEm])
  @@index([acao, ocorridoEm])
  @@index([entidade, entidadeId])
}

// Identidade anônima persistente (cookie). Quando a pessoa loga, `userId` liga
// as visitas anteriores à conta — é o que permite ver o que o cliente olhou
// antes de comprar.
model Visitante {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Quem é essa pessoa, quando a gente descobre.
  ///
  /// `userId` só pega quem faz login, e quase ninguém faz: a loja vende por
  /// WhatsApp e por checkout sem cadastro. O vínculo útil é com Cliente, que
  /// é onde mora o comprador de verdade.
  ///
  /// NÃO é unique de propósito: a mesma pessoa no celular e no computador são
  /// dois visitantes, e os dois apontam para o mesmo cliente. É isso que junta
  /// a navegação dela num histórico só.
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  /// Quando e como a identidade foi descoberta — para o painel poder dizer de
  /// onde veio a ligação em vez de só afirmar que ela existe.
  identificadoEm  DateTime?
  identificadoPor String? // 'pedido' | 'cadastro' | 'login'

  primeiroAcesso DateTime @default(now())
  ultimoAcesso   DateTime @default(now())
  totalSessoes   Int      @default(0)
  totalEventos   Int      @default(0)

  sessoes SessaoVisita[]
  eventos EventoVisitante[]

  @@index([ultimoAcesso])
  @@index([userId])
  @@index([clienteId])
}

model SessaoVisita {
  id          String    @id @default(cuid())
  visitanteId String
  visitante   Visitante @relation(fields: [visitanteId], references: [id], onDelete: Cascade)

  iniciadaEm      DateTime @default(now())
  ultimaAtividade DateTime @default(now())

  /**
   * Mascarado quando `consentimento` é false.
   */
  ip            String?
  consentimento Boolean @default(false)

  userAgent   String?
  dispositivo String? // celular | computador | tablet
  navegador   String?
  sistema     String?

  referrer      String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  paginaEntrada String?

  // Geolocalização (só com consentimento; vem do cache GeoIp).
  cidade   String?
  regiao   String?
  pais     String?
  provedor String?

  eventos EventoVisitante[]

  @@index([visitanteId, iniciadaEm])
  @@index([iniciadaEm])
}

model EventoVisitante {
  id          String       @id @default(cuid())
  visitanteId String
  visitante   Visitante    @relation(fields: [visitanteId], references: [id], onDelete: Cascade)
  sessaoId    String
  sessao      SessaoVisita @relation(fields: [sessaoId], references: [id], onDelete: Cascade)

  tipo       String // ver lib/rastreio/eventos.ts
  ocorridoEm DateTime @default(now())

  url    String?
  titulo String?

  // Produto envolvido, com nome em snapshot (o produto pode ser renomeado ou
  // excluído; o histórico não pode mentir sobre o que a pessoa viu).
  produtoId   String?
  produtoNome String?
  variantId   String?
  composicao  String?
  quantidade  Int?
  valor       Decimal? @db.Decimal(10, 2)

  busca String?
  meta  Json?

  @@index([visitanteId, ocorridoEm])
  @@index([sessaoId, ocorridoEm])
  @@index([tipo, ocorridoEm])
  @@index([produtoId, ocorridoEm])
  @@index([ocorridoEm])
}

// Cache de IP → cidade/provedor. Existe para NÃO consultar o serviço externo a
// cada evento: um IP é resolvido uma vez e reaproveitado.
model GeoIp {
  ip           String   @id
  cidade       String?
  regiao       String?
  pais         String?
  provedor     String?
  falhou       Boolean  @default(false)
  consultadoEm DateTime @default(now())
}

// ─────────────────────────────────────────────
// Shopee (marketplace)
// ─────────────────────────────────────────────

/// Ambiente da Open Platform. O sandbox tem host e credenciais próprios: a
/// mesma chave não vale nos dois.
enum AmbienteShopee {
  SANDBOX
  PRODUCAO
}

/// Ligação da loja com a Shopee. Singleton, como as outras configurações.
///
/// As chaves ficam no banco e não em variável de ambiente pelo mesmo motivo da
/// conta de e-mail: quem cria o app na Open Platform e cola as chaves é o dono,
/// e ele não mexe no Coolify. partner_key e os tokens são CRIPTOGRAFADOS
/// (AES-256-GCM, lib/cripto) — com eles dá para agir na loja em nome do dono,
/// então um dump do banco sozinho não pode entregá-los.
///
/// O access_token da Shopee dura 4 horas e o refresh_token 30 dias. Isso tem uma
/// consequência dura: se a loja passar 30 dias sem nenhuma chamada, a autorização
/// morre e o dono precisa autorizar de novo pelo painel. Por isso a renovação
/// roda no cron, não só quando alguém abre a tela.
model IntegracaoShopee {
  id    String  @id @default("default")
  ativo Boolean @default(false)

  ambiente                AmbienteShopee @default(SANDBOX)
  partnerId               String? // numérico na Shopee, guardado como texto
  partnerKeyCriptografada String?

  /// Loja autorizada. Só aparece depois que o dono passa pela tela de
  /// autorização da Shopee e volta para o nosso callback.
  shopId String?

  accessTokenCriptografado  String?
  refreshTokenCriptografado String?
  /// Quando o access_token expira (4 h). A renovação acontece antes disso.
  tokenExpiraEm             DateTime?
  /// Quando o refresh_token foi emitido. Passados 30 dias sem uso, a Shopee
  /// derruba a autorização — este campo é o que deixa o painel avisar antes.
  refreshEmitidoEm          DateTime?

  /// Última varredura de pedidos que terminou bem, e até onde ela leu. A Shopee
  /// pagina por janela de tempo, então a próxima começa daqui.
  ultimaSincronizacaoEm DateTime?
  ultimoErro            String?

  atualizadoEm DateTime @updatedAt
}

/// Produto do site ligado a um anúncio da Shopee.
///
/// A ligação é explícita, feita no painel, em vez de casar por nome: nome de
/// anúncio em marketplace é escrito para busca ("Criadeira Berçário Peixe
/// Aquário 6L Profissional"), e casar por semelhança acabaria sincronizando o
/// estoque do produto errado. Errar aqui é vender o que não existe.
model ShopeeAnuncio {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// item_id do anúncio na Shopee (inteiro grande — texto para não perder
  /// precisão no JavaScript).
  itemId  String
  /// model_id da variação, quando o anúncio tem variação. Nulo = anúncio simples.
  modelId String?
  /// Título do anúncio na Shopee, para o painel mostrar o que foi ligado.
  titulo  String?

  /// Último estoque que conseguimos escrever lá. Serve para não repetir chamada
  /// à toa e para o painel mostrar se os dois lados batem.
  estoqueEnviado Int?
  sincronizadoEm DateTime?
  ultimoErro     String?

  criadoEm DateTime @default(now())

  @@unique([itemId, modelId])
  @@index([productId])
}
