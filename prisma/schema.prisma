// Guppy de Linhagem — schema do banco de dados
// Single-store e-commerce: roles CUSTOMER e ADMIN apenas

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ProductType {
  FISICO
  DIGITAL
}

enum VideoPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
}

// ─────────────────────────────────────────────
// Usuários e Endereços
// ─────────────────────────────────────────────

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  senhaHash String?
  nome      String
  telefone  String?
  role      UserRole  @default(CUSTOMER)
  criadoEm DateTime  @default(now())

  enderecos Address[]
  pedidos   Order[]
  waitlist  WaitlistEntry[]
}

model Address {
  id          String  @id @default(cuid())
  userId      String
  cep         String
  rua         String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  estado      String
  principal   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// Catálogo
// ─────────────────────────────────────────────

model Category {
  id    String @id @default(cuid())
  slug  String @unique
  nome  String
  ordem Int    @default(0)

  produtos Product[]
}

model Product {
  id             String      @id @default(cuid())
  slug           String      @unique
  nome           String
  descricao      String
  descricaoCurta String?
  preco          Decimal     @db.Decimal(10, 2)
  descontoPix    Decimal?    @db.Decimal(5, 2)
  parcelasMax    Int         @default(3)
  tipo           ProductType @default(FISICO)
  estoque        Int         @default(0)
  peso           Decimal?    @db.Decimal(8, 3)
  comprimento    Decimal?    @db.Decimal(8, 2)
  largura        Decimal?    @db.Decimal(8, 2)
  altura         Decimal?    @db.Decimal(8, 2)
  ativo          Boolean     @default(true)
  categoryId     String
  criadoEm      DateTime    @default(now())
  atualizadoEm  DateTime    @updatedAt

  category   Category       @relation(fields: [categoryId], references: [id])
  imagens    ProductImage[]
  videos     ProductVideo[]
  waitlist   WaitlistEntry[]
  orderItems OrderItem[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  ordem     Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVideo {
  id           String        @id @default(cuid())
  productId    String
  platform     VideoPlatform
  videoId      String
  originalUrl  String
  thumbnailUrl String?
  ordem        Int           @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model WaitlistEntry {
  id         String   @id @default(cuid())
  productId  String
  userId     String?
  email      String
  notificado Boolean  @default(false)
  criadoEm  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@unique([productId, email])
}

// ─────────────────────────────────────────────
// Pedidos
// ─────────────────────────────────────────────

model Order {
  id               String      @id @default(cuid())
  numero           String      @unique
  userId           String
  subtotal         Decimal     @db.Decimal(10, 2)
  desconto         Decimal     @default(0) @db.Decimal(10, 2)
  frete            Decimal     @db.Decimal(10, 2)
  total            Decimal     @db.Decimal(10, 2)
  metodoPagamento  String
  parcelas         Int         @default(1)
  status           OrderStatus @default(PENDING)
  mpPaymentId      String?
  mpPreferenceId   String?
  enderecoEntrega  Json
  codigoRastreio   String?
  meCalcId         String?
  meShipmentId     String?
  criadoEm        DateTime    @default(now())
  atualizadoEm    DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  quantidade     Int
  precoUnitario  Decimal @db.Decimal(10, 2)
  nomeSnapshot   String
  imagemSnapshot String?

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}
