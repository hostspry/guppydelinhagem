# ─────────────────────────────────────────────────────────────
# Guppy de Linhagem — Variáveis de Ambiente
# Copie para .env e preencha com seus valores reais.
# Em produção (CapRover), configure no painel App Configs.
# ─────────────────────────────────────────────────────────────

# Banco de dados
# Dev local: postgresql://postgres:postgres@localhost:5432/guppy
# CapRover: usar o endereço interno do app PostgreSQL
DATABASE_URL="postgresql://guppy:SUA_SENHA@srv-captain--guppy-db:5432/guppy"

# NextAuth v5
NEXTAUTH_URL="https://guppydelinhagem.com.br"
NEXTAUTH_SECRET=""  # gerar com: openssl rand -base64 32

# Google OAuth (criar em console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Mercado Pago (painel de desenvolvedores: mercadopago.com.br/developers)
MP_ACCESS_TOKEN=""
# Public key — lida em RUNTIME no servidor e injetada no checkout por prop
# (sem prefixo NEXT_PUBLIC_ → não depende de build-time/build arg). Não é segredo.
MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""

# PagBank / PagSeguro (developer.pagbank.com.br) — 2º adquirente, checkout
# hospedado card-only (o cliente digita o cartão na página do PagBank).
PAGBANK_TOKEN=""            # Bearer token da conta (server-only, NUNCA vai ao client)
PAGBANK_ENV="sandbox"       # sandbox | production (define a URL base)
# Segredo p/ validar a autenticidade do webhook: x-authenticity-token =
# SHA256(PAGBANK_WEBHOOK_TOKEN + "-" + corpo cru). É o token da conta usado pelo
# PagBank para assinar as notificações (normalmente = PAGBANK_TOKEN).
PAGBANK_WEBHOOK_TOKEN=""

# Melhor Envio (painel: melhorenvio.com.br/painel/gerenciar-aplicacoes)
ME_CLIENT_ID=""
ME_CLIENT_SECRET=""
ME_TOKEN=""  # gerado via OAuth do Melhor Envio
# Token Bearer pronto pra calcular frete (Jadlog) via /api/frete
MELHOR_ENVIO_TOKEN=""

# Email transacional (resend.com)
RESEND_API_KEY=""
EMAIL_FROM="Guppy de Linhagem <nao-responda@guppydelinhagem.com.br>"

# Storage de mídia — Garage (S3-compatible, self-hosted no Coolify)
# Todas server-side (NUNCA NEXT_PUBLIC). No Coolify: marcar como Runtime.
S3_ENDPOINT="https://s3-xxxxxxxx.sslip.io"   # endpoint S3 do Garage
S3_REGION="garage"
S3_BUCKET="guppy-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL="https://media.guppydelinhagem.com.br"  # alias público (leitura)

# IA — geração de conteúdo de produto (Google AI Studio / Gemini)
# Criar em: aistudio.google.com/app/apikey  • server-side, NUNCA NEXT_PUBLIC
GEMINI_API_KEY=""

# Configurações do app
APP_VERSION="0.1.0"
CEP_ORIGEM="29000000"  # CEP de origem dos envios (Guarapari-ES)
